# Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Groq Cloud LLM (contextual validation, Layer 2).
# Server-side only: read via $env/dynamic/private in src/routes/api/analyze.
# Never prefix these with VITE_ — that would expose the key to the client bundle.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
